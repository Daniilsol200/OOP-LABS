<Window x:Class="EquipmentRegistryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реестр оборудования" Height="600" Width="1000">
    <Window.Resources>
        <!-- Стиль для центрирования содержимого ячеек -->
        <Style x:Key="CenteredCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Стиль для выравнивания содержимого ячеек по правому краю -->
        <Style x:Key="RightAlignedCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Стиль для выравнивания содержимого ячеек по левому краю -->
        <Style x:Key="LeftAlignedCellStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Стиль для центрирования заголовков -->
        <Style x:Key="CenteredHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0,0,0,10">
            <MenuItem Header="_Таблицы">
                <MenuItem x:Name="menuEquipment" Header="Оборудование" Click="MenuEquipment_Click" IsChecked="True"/>
                <MenuItem x:Name="menuOrganization" Header="Организации" Click="MenuOrganization_Click"/>
                <MenuItem x:Name="menuType" Header="Типы оборудования" Click="MenuType_Click"/>
            </MenuItem>
        </Menu>

        <GroupBox Grid.Row="1" x:Name="groupBoxForm" Header="Фильтры оборудования" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <StackPanel x:Name="equipmentForm" Visibility="Visible">
                    <TextBlock Text="Год изготовления:"/>
                    <TextBox x:Name="txtYear" Margin="0,0,0,5"/>
                    <TextBlock Text="Стоимость:"/>
                    <TextBox x:Name="txtCost" Margin="0,0,0,5"/>
                </StackPanel>

                <StackPanel x:Name="organizationForm" Visibility="Collapsed">
                    <TextBlock Text="Название организации:"/>
                    <TextBox x:Name="txtOrgName" Margin="0,0,0,5"/>
                </StackPanel>

                <StackPanel x:Name="typeForm" Visibility="Collapsed">
                    <TextBlock Text="Название типа:"/>
                    <TextBox x:Name="txtTypeName" Margin="0,0,0,5"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnFilterByCost" Content="Фильтр по стоимости" Width="120" Margin="0,0,5,0" Click="BtnFilterByCost_Click" Visibility="Visible"/>
                    <Button x:Name="btnFilterByYear" Content="Фильтр по году" Width="110" Margin="0,0,5,0" Click="BtnFilterByYear_Click" Visibility="Visible"/>
                    <Button x:Name="btnAverageCostByType" Content="Средн. стоимость по типу" Width="150" Margin="0,0,5,0" Click="BtnAverageCostByType_Click" Visibility="Visible"/>
                    <Button x:Name="btnCountByOrg" Content="Кол-во по орг." Width="100" Margin="0,0,0,0" Click="BtnCountByOrg_Click" Visibility="Visible"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="2">
            <DataGrid x:Name="dgEquipment" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" RowEditEnding="DgEquipment_RowEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding equip_id}" Width="50" ElementStyle="{StaticResource CenteredCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding equip_name, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource LeftAlignedCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                    <DataGridTextColumn Header="Год" Binding="{Binding manufacture_year, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource CenteredCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                    <DataGridTextColumn Header="Стоимость" Binding="{Binding cost, UpdateSourceTrigger=PropertyChanged}" Width="120" ElementStyle="{StaticResource RightAlignedCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                    <DataGridComboBoxColumn Header="Организация" SelectedValueBinding="{Binding org_id, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="OrgId" DisplayMemberPath="OrgName" Width="190" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridComboBoxColumn Header="Тип" SelectedValueBinding="{Binding type_id, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="TypeId" DisplayMemberPath="TypeName" Width="190" HeaderStyle="{StaticResource CenteredHeaderStyle}">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="dgOrganizations" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" RowEditEnding="DgOrganizations_RowEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding OrgId}" Width="50" ElementStyle="{StaticResource CenteredCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Название организации" Binding="{Binding OrgName, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource LeftAlignedCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="dgTypes" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" RowEditEnding="DgTypes_RowEditEnding">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding TypeId}" Width="50" ElementStyle="{StaticResource CenteredCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Название типа" Binding="{Binding TypeName, UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource LeftAlignedCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="dgOrgCount" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Организация" Binding="{Binding org_name}" Width="*" ElementStyle="{StaticResource LeftAlignedCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding equipment_count}" Width="100" ElementStyle="{StaticResource CenteredCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="dgTypeAverage" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Тип" Binding="{Binding type_name}" Width="*" ElementStyle="{StaticResource LeftAlignedCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                    <DataGridTextColumn Header="Средняя стоимость" Binding="{Binding average_cost}" Width="120" ElementStyle="{StaticResource RightAlignedCellStyle}" HeaderStyle="{StaticResource CenteredHeaderStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock x:Name="txtStatus" Grid.Row="3" Foreground="Red" Margin="0,10,0,0"/>
    </Grid>
</Window>